# =================================================================
# STATSKILL AI - BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================

# Server Port (Render/Railway automatically assign PORT)
PORT=5000
NODE_ENV=production

# CORS Whitelist (comma-separated origins allowed to make requests)
# Example: CORS_ORIGIN=https://statskill-ai.vercel.app,https://your-custom-domain.com
CORS_ORIGIN=*

# AI Engine Configuration (Google Gemini / Domain Engine)
# Optional: If not provided, StatSkill uses high-fidelity domain reasoning & assessment generation algorithms
GEMINI_API_KEY=

# Supabase Managed PostgreSQL Database Connection
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Supabase Cloud Storage (for uploaded PDF materials & curriculum files)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=learning-materials

# JWT / Session Secret (Optional)
AUTH_SECRET=statskill-sih-prototype-secure-token-2026
